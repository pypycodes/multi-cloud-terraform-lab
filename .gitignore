###############################################################################
# Terraform
###############################################################################

# Terraform working directory
**/.terraform/*
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform lock info
.terraform.tfstate.lock.info

# Crash logs
crash.log
crash.*.log

# Terraform plan output
*.tfplan
plan.out
planfile

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Graph files
*.dot

###############################################################################
# Terraform Variables
###############################################################################

# Never commit environment-specific values
*.tfvars
*.tfvars.json

# Auto-loaded variable files
*.auto.tfvars
*.auto.tfvars.json

terraform.tfvars
terraform.tfvars.json

###############################################################################
# Credentials / Secrets
###############################################################################

credentials.json
outputs.json
inventory.json

# Private keys
*.pem
*.key
*.p12
*.pfx

# Certificates
*.crt
*.cer

